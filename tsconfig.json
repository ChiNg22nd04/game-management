{
    "compilerOptions": {
        "types": [
            "@types/node",
            "nuxt"
        ],
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ],
            "#app": [
                "./.nuxt/types/app"
            ],
            "#app/*": [
                "./.nuxt/types/app/*"
            ]
        }
    },
    "include": [
        "test.ts",
        "server/**/*.ts",
        "nuxt.config.ts",
        "vite.config.ts",
        "**/*.vue",
        "**/*.ts"
    ]
}