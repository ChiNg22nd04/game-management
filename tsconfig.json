{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ]
        }
    },
    "include": [
        "test.ts",
        "server/**/*.ts",
        "nuxt.config.ts",
        "vite.config.ts",
        "**/*.vue",
        "**/*.ts"
    ]
}